# Copy to .env and fill in your values. Never commit .env.

# Required: API key for POST /capture (send as X-API-Key header)
API_KEY=your-secret-api-key

# LLM: OpenAI / OpenRouter / SiliconFlow (OpenAI 兼容接口)
# 这里可以直接填 SiliconFlow 的 API Key
OPENAI_API_KEY=your-siliconflow-api-key
# SiliconFlow 的 OpenAI 兼容 base_url（以官方文档为准）
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# 模型名：例如你给的 Pro/zai-org/GLM-4.7
OPENAI_MODEL=Pro/zai-org/GLM-4.7

# GitHub: token and repo (e.g. username/repo-name)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=username/your-repo
