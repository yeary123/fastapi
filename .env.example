# Copy to .env and fill in your values. Never commit .env.

# Required: API key for POST /capture (send as X-API-Key header)
API_KEY=your-secret-api-key

# LLM: OpenAI or OpenRouter (set OPENAI_BASE_URL for OpenRouter)
OPENAI_API_KEY=sk-...
# Optional: e.g. https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# Optional: model name (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# GitHub: token and repo (e.g. username/repo-name)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=username/your-repo
